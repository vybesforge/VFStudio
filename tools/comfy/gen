def g_edit(a):
    """Instruction-based editing (Qwen-Image-Edit 2509): keeps the subject, changes what you say.
    Mirrors the official template: FluxKontextImageScale -> TextEncodeQwenImageEditPlus (pos/neg share the
    image) -> ModelSamplingAuraFlow(3) -> CFGNorm -> KSampler. --fast = Lightning LoRA, 4 steps, cfg 1
    (default 20 steps, cfg 4). Up to three reference images condition the edit (e.g. 'put the object
    from image 2 into image 1')."""
    need("edit")
    if a.fast:
        need("edit_lightning")
    # Prefer the Q4 GGUF: fp8 has no MPS kernel, so ComfyUI upcasts the 20 GB fp8 file to 39 GB bf16
    # (measured: 10 GB swap, 26-65 s/step). The GGUF stays ~13 GB and needs the ComfyUI-GGUF node pack.
    gguf = os.path.exists(f"{MODELS}/unet/Qwen-Image-Edit-2509-Q4_K_M.gguf") and not a.fp8
    if not gguf:
        need("edit_fp8")
    imgs = [upload_image(p) for p in [a.image, a.ref2, a.ref3] if p]
    steps = a.steps or (4 if a.fast else 20)
    cfg = a.cfg if a.cfg is not None else (1.0 if a.fast else 4.0)
    g = {
        "1": ({"class_type": "UnetLoaderGGUF", "inputs": {"unet_name": "Qwen-Image-Edit-2509-Q4_K_M.gguf"}} if gguf else
              {"class_type": "UNETLoader", "inputs": {"unet_name": "qwen_image_edit_2509_fp8_e4m3fn.safetensors", "weight_dtype": "default"}}),
        "2": {"class_type": "CLIPLoader", "inputs": {"clip_name": "qwen_2.5_vl_7b_fp8_scaled.safetensors", "type": "qwen_image", "device": "default"}},
        "3": {"class_type": "VAELoader", "inputs": {"vae_name": "qwen_image_vae.safetensors"}},
        "4": {"class_type": "LoadImage", "inputs": {"image": imgs[0]}},
        "5": {"class_type": "FluxKontextImageScale", "inputs": {"image": ["4", 0]}},
        "8": {"class_type": "ModelSamplingAuraFlow", "inputs": {"model": ["7", 0] if a.fast else ["1", 0], "shift": 3.0}},
        "9": {"class_type": "CFGNorm", "inputs": {"model": ["8", 0], "strength": 1.0}},
        "10": {"class_type": "TextEncodeQwenImageEditPlus", "inputs": {"clip": ["2", 0], "vae": ["3", 0], "prompt": a.prompt, "image1": ["5", 0]}},
        "11": {"class_type": "TextEncodeQwenImageEditPlus", "inputs": {"clip": ["2", 0], "vae": ["3", 0], "prompt": a.negative or "", "image1": ["5", 0]}},
        "12": {"class_type": "VAEEncode", "inputs": {"pixels": ["5", 0], "vae": ["3", 0]}},
        "13": {"class_type": "KSampler", "inputs": {"model": ["9", 0], "positive": ["10", 0], "negative": ["11", 0], "latent_image": ["12", 0],
                                                  "seed": seed_of(a), "steps": steps, "cfg": cfg, "sampler_name": "euler", "scheduler": "simple", "denoise": 1.0}},
        "14": {"class_type": "VAEDecode", "inputs": {"samples": ["13", 0], "vae": ["3", 0]}},
        "15": {"class_type": "SaveImage", "inputs": {"images": ["14", 0], "filename_prefix": "gen/edit"}},
    }
    if a.fast:
        g["7"] = {"class_type": "LoraLoaderModelOnly", "inputs": {"model": ["1", 0], "lora_name": "Qwen-Image-Edit-2509-Lightning-4steps-V1.0-bf16.safetensors", "strength_model": 1.0}}
    for i, name in enumerate(imgs[1:], start=2):
        nid = str(20 + i)
        g[nid] = {"class_type": "LoadImage", "inputs": {"image": name}}
        g["10"]["inputs"][f"image{i}"] = [nid, 0]
        g["11"]["inputs"][f"image{i}"] = [nid, 0]
    return g


