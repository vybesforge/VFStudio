def _snap16(v):
    return max(64, int(round(v / 16.0)) * 16)


def video_dims(a, default):
    """Output size for a video job: explicit --w/--h win, else the start image decides.

    An i2v start image is scaled into the latent's width/height, so a fixed 1280x704 latent
    re-frames a square upload (crop or letterbox) and the clip no longer matches the picture
    it came from. Taking the aspect from the image (area capped, sides snapped to 16 — the
    Wan/Hunyuan VAE needs multiples of 16) keeps the framing identical."""
    if a.w and a.h:
        return int(a.w), int(a.h)
    if a.image:
        try:
            from PIL import Image
            with Image.open(a.image) as im:
                iw, ih = im.size
            budget = min(1280 * 704, iw * ih)          # never upscale past the source area
            scale = min(1.0, (budget / float(iw * ih)) ** 0.5, 1280.0 / max(iw, ih))
            w, h = _snap16(iw * scale), _snap16(ih * scale)
            print(f"[gen] video size {w}x{h} from {a.image} ({iw}x{ih}), snapped to 16")
            return w, h
        except Exception as exc:
            print(f"[gen] could not read {a.image} for its size ({exc}); using {default}")
    return default


def g_video_hyv15(a):
    """HunyuanVideo 1.5 (8.3B) — the quality path. cfg-distilled checkpoints: cfg 1, no negative needed.
    t2v uses the 480p model (832x480), i2v the 720p model (1280x704). Graph mirrors the official templates
    (DualCLIPLoader hunyuan_video_15, ModelSamplingSD3 shift 7, SamplerCustomAdvanced euler/simple), minus the
    optional 1080p super-resolution stage. UNTESTED on this Mac as of 2026-11-02 — measure and record."""
    need("hyv15_common")
    i2v = bool(a.image)
    need("hyv15_i2v" if i2v else "hyv15_t2v")
    unet = "hunyuanvideo1.5_720p_i2v_cfg_distilled_fp16.safetensors" if i2v else "hunyuanvideo1.5_480p_t2v_cfg_distilled_fp16.safetensors"
    w, h = video_dims(a, (1280, 704) if i2v else (832, 480))   # t2v model is 480p-native
    steps = a.steps or 20
    g = {
        "1": {"class_type": "UNETLoader", "inputs": {"unet_name": unet, "weight_dtype": "default"}},
        "2": {"class_type": "DualCLIPLoader", "inputs": {"clip_name1": "qwen_2.5_vl_7b_fp8_scaled.safetensors", "clip_name2": "byt5_small_glyphxl_fp16.safetensors", "type": "hunyuan_video_15", "device": "default"}},
        "3": {"class_type": "VAELoader", "inputs": {"vae_name": "hunyuanvideo15_vae_fp16.safetensors"}},
        "4": {"class_type": "ModelSamplingSD3", "inputs": {"model": ["1", 0], "shift": 7.0}},
        "5": {"class_type": "CLIPTextEncode", "inputs": {"text": a.prompt, "clip": ["2", 0]}},
        "6": {"class_type": "CLIPTextEncode", "inputs": {"text": a.negative or "", "clip": ["2", 0]}},
        "20": {"class_type": "RandomNoise", "inputs": {"noise_seed": seed_of(a)}},
        "21": {"class_type": "KSamplerSelect", "inputs": {"sampler_name": "euler"}},
        "22": {"class_type": "BasicScheduler", "inputs": {"model": ["4", 0], "scheduler": "simple", "steps": steps, "denoise": 1.0}},
        "23": {"class_type": "CFGGuider", "inputs": {"model": ["4", 0], "positive": ["5", 0], "negative": ["6", 0], "cfg": 1.0}},
        "24": {"class_type": "SamplerCustomAdvanced", "inputs": {"noise": ["20", 0], "guider": ["23", 0], "sampler": ["21", 0], "sigmas": ["22", 0], "latent_image": ["7", 0]}},
        "9": {"class_type": "VAEDecode", "inputs": {"samples": ["24", 0], "vae": ["3", 0]}},
        "10": {"class_type": "CreateVideo", "inputs": {"images": ["9", 0], "fps": a.fps}},
        "11": {"class_type": "SaveVideo", "inputs": {"video": ["10", 0], "filename_prefix": "gen/hyv15", "format": "auto", "codec": "auto"}},
    }
    if i2v:
        g["12"] = {"class_type": "LoadImage", "inputs": {"image": upload_image(a.image)}}
        g["13"] = {"class_type": "CLIPVisionLoader", "inputs": {"clip_name": "sigclip_vision_patch14_384.safetensors"}}
        g["14"] = {"class_type": "CLIPVisionEncode", "inputs": {"clip_vision": ["13", 0], "image": ["12", 0], "crop": "center"}}
        g["7"] = {"class_type": "HunyuanVideo15ImageToVideo", "inputs": {"positive": ["5", 0], "negative": ["6", 0], "vae": ["3", 0], "start_image": ["12", 0],
                                                                 "clip_vision_output": ["14", 0], "width": w, "height": h, "length": a.frames, "batch_size": 1}}
        g["23"]["inputs"]["positive"] = ["7", 0]; g["23"]["inputs"]["negative"] = ["7", 1]
        g["24"]["inputs"]["latent_image"] = ["7", 2]
    else:
        g["7"] = {"class_type": "EmptyHunyuanVideo15Latent", "inputs": {"width": w, "height": h, "length": a.frames, "batch_size": 1}}
    return g


def g_video(a):
    if getattr(a, "model", "wan") == "hyv15":
        return g_video_hyv15(a)
    need("video")
    w, h = video_dims(a, (1280, 704))
    g = {
        "1": {"class_type": "UNETLoader", "inputs": {"unet_name": "wan2.2_ti2v_5B_fp16.safetensors", "weight_dtype": "default"}},
        "2": {"class_type": "CLIPLoader", "inputs": {"clip_name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors", "type": "wan", "device": "default"}},
        "3": {"class_type": "VAELoader", "inputs": {"vae_name": "wan2.2_vae.safetensors"}},
        "4": {"class_type": "ModelSamplingSD3", "inputs": {"model": ["1", 0], "shift": 8.0}},
        "5": {"class_type": "CLIPTextEncode", "inputs": {"text": a.prompt, "clip": ["2", 0]}},
        "6": {"class_type": "CLIPTextEncode", "inputs": {"text": a.negative or NEG_WAN, "clip": ["2", 0]}},
        "7": {"class_type": "Wan22ImageToVideoLatent", "inputs": {"vae": ["3", 0], "width": w, "height": h, "length": a.frames, "batch_size": 1}},
        "8": {"class_type": "KSampler", "inputs": {"model": ["4", 0], "positive": ["5", 0], "negative": ["6", 0], "latent_image": ["7", 0],
                                                 "seed": seed_of(a), "steps": a.steps, "cfg": 5.0, "sampler_name": "uni_pc", "scheduler": "simple", "denoise": 1.0}},
        "9": {"class_type": "VAEDecode", "inputs": {"samples": ["8", 0], "vae": ["3", 0]}},
