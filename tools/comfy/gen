def have(key):
    return all(os.path.exists(f"{MODELS}/{p}") for p in FILES[key])


def need(key):
    missing = [p for p in FILES[key] if not os.path.exists(f"{MODELS}/{p}")]
    if missing:
        die(f"missing model files for '{key}': {missing}. Run: fetch-models  (then: stack restart comfy)")


def die(msg, code=2):
    print(json.dumps({"ok": False, "error": msg}))
    sys.exit(code)


# ---------------- HTTP ----------------
def http(method, path, payload=None, timeout=30):
    data = json.dumps(payload).encode() if payload is not None else None
    req = urllib.request.Request(HOST + path, data=data, method=method,
                                 headers={"Content-Type": "application/json"} if data else {})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        body = r.read()
        return json.loads(body) if body else {}


def server_up():
    try:
        http("GET", "/system_stats", timeout=3)
        return True
    except Exception:
        return False


def wait_idle(now=False):
    if now:
        return
    t0 = time.time()
    while True:
        q = http("GET", "/queue")
        if not q["queue_running"] and not q["queue_pending"]:
            return
        if time.time() - t0 > 7200:
            die("queue busy for 2 h; giving up")
        time.sleep(5)


def upload_image(path):
    import mimetypes
    boundary = uuid.uuid4().hex
    name = os.path.basename(path)
    ctype = mimetypes.guess_type(path)[0] or "application/octet-stream"
    body = (f"--{boundary}\r\nContent-Disposition: form-data; name=\"image\"; filename=\"{name}\"\r\n"
            f"Content-Type: {ctype}\r\n\r\n").encode() + open(path, "rb").read() + \
           f"\r\n--{boundary}\r\nContent-Disposition: form-data; name=\"overwrite\"\r\n\r\ntrue\r\n--{boundary}--\r\n".encode()
    req = urllib.request.Request(HOST + "/upload/image", data=body, method="POST",
                                 headers={"Content-Type": f"multipart/form-data; boundary={boundary}"})
    with urllib.request.urlopen(req, timeout=120) as r:
        return json.loads(r.read())["name"]


def run(prompt, kind, out_dir, timeout, now=False):
    if not server_up():
        die(f"ComfyUI is not running at {HOST}. Start it: stack start comfy")
    wait_idle(now)
    t0 = time.time()
    res = http("POST", "/prompt", {"prompt": prompt, "client_id": "gen-cli"})
    if "prompt_id" not in res:
        die(f"submit rejected: {json.dumps(res)[:800]}")
    pid = res["prompt_id"]
    while True:
        time.sleep(2)
        h = http("GET", f"/history/{pid}")
        if pid in h:
            entry = h[pid]
            break
        if time.time() - t0 > timeout:
            die(f"timed out after {timeout}s (prompt {pid} still running — check {HOST}/queue)")
    st = entry.get("status", {})
    if st.get("status_str") == "error":
        msgs = [m for m in st.get("messages", []) if m[0] == "execution_error"]
        die(f"execution error: {json.dumps(msgs)[:1200]}")
    files = []
    os.makedirs(out_dir, exist_ok=True)
    for node_out in entry.get("outputs", {}).values():
        for key in ("images", "audio", "video", "gifs"):
            for item in node_out.get(key, []) or []:
                if item.get("type") != "output":
                    continue
                src = os.path.join(COMFY_OUT, item.get("subfolder", ""), item["filename"])
                if os.path.exists(src):
                    dst = os.path.join(out_dir, item["filename"])
                    shutil.copy2(src, dst)
                    files.append(dst)
    if not files:
        die(f"prompt {pid} finished with status '{st.get('status_str')}' but wrote no output files — treat as failed")
    print(json.dumps({"ok": True, "kind": kind, "files": files, "seconds": round(time.time() - t0, 1), "prompt_id": pid}))


def seed_of(a):
    return a.seed if a.seed is not None and a.seed >= 0 else random.randint(0, 2**53)


