def g_upscale(a):
    img = upload_image(a.image)
    if a.method in ("esrgan", "ultrasharp"):
        need(a.method)
        model = "RealESRGAN_x4plus.pth" if a.method == "esrgan" else "4x-UltraSharp.pth"
        g = {
            "1": {"class_type": "LoadImage", "inputs": {"image": img}},
            "2": {"class_type": "UpscaleModelLoader", "inputs": {"model_name": model}},
            "3": {"class_type": "ImageUpscaleWithModel", "inputs": {"upscale_model": ["2", 0], "image": ["1", 0]}},
        }
        last = "3"
        if a.scale != 4:  # models are 4x; rescale afterwards to the requested factor
            g["4"] = {"class_type": "ImageScaleBy", "inputs": {"image": ["3", 0], "upscale_method": "lanczos", "scale_by": a.scale / 4.0}}
            last = "4"
        g["9"] = {"class_type": "SaveImage", "inputs": {"images": [last, 0], "filename_prefix": "gen/upscale"}}
        return g
    need("seedvr2")
    return {
        "1": {"class_type": "LoadImage", "inputs": {"image": img}},
        "2": {"class_type": "UNETLoader", "inputs": {"unet_name": "seedvr2_3b_int8_convrot.safetensors", "weight_dtype": "default"}},
        "3": {"class_type": "VAELoader", "inputs": {"vae_name": "seedvr2_ema_vae_fp16.safetensors"}},
        "4": {"class_type": "ImageScaleBy", "inputs": {"image": ["1", 0], "upscale_method": "lanczos", "scale_by": float(a.scale)}},
        "5": {"class_type": "SeedVR2Preprocess", "inputs": {"resized_images": ["4", 0]}},
        "6": {"class_type": "VAEEncodeTiled", "inputs": {"pixels": ["5", 0], "vae": ["3", 0], "tile_size": 512, "overlap": 128, "temporal_size": 4096, "temporal_overlap": 8}},
        "7": {"class_type": "SeedVR2Conditioning", "inputs": {"model": ["2", 0], "vae_conditioning": ["6", 0]}},
        "8": {"class_type": "KSampler", "inputs": {"model": ["2", 0], "positive": ["7", 0], "negative": ["7", 1], "latent_image": ["6", 0],
