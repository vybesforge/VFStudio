def cmd_status(a):
    up = server_up()
    info = {"server": HOST, "up": up, "models": {k: have(k) for k in FILES}}
    if up:
        q = http("GET", "/queue")
        info["queue"] = {"running": len(q["queue_running"]), "pending": len(q["queue_pending"])}
    print(json.dumps(info, indent=2))


def main():
    p = argparse.ArgumentParser(prog="gen", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)

    def common(sp, kind):
        sp.add_argument("--out", default=f"{OUT_ROOT}/{kind}")
        sp.add_argument("--seed", type=int, default=None)
        sp.add_argument("--steps", type=int, default=None)
        sp.add_argument("--now", action="store_true", help="do not wait for an idle queue")
        sp.add_argument("--timeout", type=int, default=None)

    s = sub.add_parser("image"); s.add_argument("prompt"); s.add_argument("--model", choices=["zimage", "klein", "flux"], default="zimage")
    s.add_argument("--w", type=int, default=1024); s.add_argument("--h", type=int, default=1024); s.add_argument("--n", type=int, default=1); common(s, "image")

    s = sub.add_parser("control"); s.add_argument("prompt"); s.add_argument("--image", required=True); s.add_argument("--mode", choices=["canny", "raw"], default="canny")
    s.add_argument("--strength", type=float, default=1.0); s.add_argument("--max-dim", type=int, default=1024); s.add_argument("--save-control", action="store_true"); common(s, "control")

    s = sub.add_parser("upscale"); s.add_argument("image"); s.add_argument("--method", choices=["esrgan", "ultrasharp", "seedvr2"], default="esrgan")
    s.add_argument("--scale", type=float, default=4); common(s, "upscale")

    s = sub.add_parser("video"); s.add_argument("prompt"); s.add_argument("--image"); s.add_argument("--negative")
    s.add_argument("--w", type=int, default=1280); s.add_argument("--h", type=int, default=704); s.add_argument("--frames", type=int, default=121)
    s.add_argument("--fps", type=int, default=24); common(s, "video"); s.set_defaults(steps=20)

    s = sub.add_parser("sfx"); s.add_argument("prompt"); s.add_argument("--model", choices=["sao", "sa3"], default="sao")
    s.add_argument("--seconds", type=float, default=10); s.add_argument("--negative"); common(s, "sfx")

    s = sub.add_parser("music"); s.add_argument("prompt", help="style tags, e.g. 'lo-fi hip hop, warm rhodes, vinyl crackle, 85 bpm'")
    s.add_argument("--lyrics"); s.add_argument("--lyrics-file"); s.add_argument("--seconds", type=float, default=120); s.add_argument("--bpm", type=int, default=120)
    s.add_argument("--timesig", default="4"); s.add_argument("--language", default="en"); s.add_argument("--key", default="C major"); common(s, "music")

    sub.add_parser("status")
    a = p.parse_args()

    if a.cmd == "status":
        return cmd_status(a)
    builders = {"image": g_image, "control": g_control, "upscale": g_upscale, "video": g_video, "sfx": g_sfx, "music": g_music}
    default_timeout = {"image": 900, "control": 900, "upscale": 1800, "video": 7200, "sfx": 900, "music": 1800}[a.cmd]
    if a.cmd == "video" and a.steps is None:
        a.steps = 20
    prompt = builders[a.cmd](a)
    run(prompt, a.cmd, a.out, a.timeout or default_timeout, now=a.now)


if __name__ == "__main__":
    main()
