#!/Users/dcruse/media-stack/stems/.venv/bin/python
"""stems — local music stem separation (Demucs on Apple Silicon MPS).

Everything runs on this Mac. No cloud calls.

  stems split <audio> [--model htdemucs|htdemucs_ft|htdemucs_6s|mdx_extra] [--two-stems vocals] [--out DIR] [--mp3]
  stems karaoke <audio> [--model ...] [--out DIR] [--mp3]     (= --two-stems vocals; returns no_vocals)
  stems status

Prints exactly one JSON line at the end:
  {"ok": true, "files": [...], "seconds": 12.3, "model": "htdemucs", "device": "mps"}
  {"ok": false, "error": "..."}
"""
import argparse
import glob
import json
import os
import shutil
import subprocess
import sys
import time

HOME = os.path.expanduser("~")
STACK = os.environ.get("MEDIA_STACK", f"{HOME}/media-stack")
VENV_PY = f"{STACK}/stems/.venv/bin/python"
OUT_ROOT = f"{STACK}/output/stems"
MODELS = ["htdemucs", "htdemucs_ft", "htdemucs_6s", "mdx_extra"]
STEM_NAMES = ["drums", "bass", "other", "vocals", "guitar", "piano"]
AUDIO_EXT = (".flac", ".wav", ".mp3", ".m4a", ".aac", ".ogg", ".opus", ".aiff", ".aif", ".wma", ".mp4", ".mov")


def _find_ffmpeg(name="ffmpeg"):
    """FFMPEG env var > PATH > Hermes-bundled build. Portable across machines."""
    env = os.environ.get(name.upper())
    if env and os.path.exists(env):
        return env
    w = shutil.which(name)
    if w:
        return w
    hits = sorted(glob.glob(os.path.expanduser(f"~/.hermes/tools/ffmpeg-*/{name}")))
    return hits[-1] if hits else None


FFMPEG = _find_ffmpeg()


def emit(obj, code=0):
    print(json.dumps(obj))
    sys.exit(code)


def die(msg, code=1):
    print(f"error: {msg}", file=sys.stderr)
    emit({"ok": False, "error": msg}, code)


def pick_device():
    """mps when available, else cpu (with a warning on stderr)."""
    forced = os.environ.get("STEMS_DEVICE")
    if forced:
        return forced
    try:
        import torch
        if torch.backends.mps.is_available():
            return "mps"
    except Exception as e:  # torch missing / broken
        print(f"warning: torch check failed ({e}); using cpu", file=sys.stderr)
        return "cpu"
    print("warning: MPS not available, falling back to cpu (slow)", file=sys.stderr)
    return "cpu"


def to_wav(src, workdir):
    """Decode anything ffmpeg can read into a 44.1 kHz stereo wav for demucs."""
    if not FFMPEG:
        die("ffmpeg not found (set FFMPEG=/path/to/ffmpeg)")
    os.makedirs(workdir, exist_ok=True)
    dst = os.path.join(workdir, os.path.splitext(os.path.basename(src))[0] + ".wav")
    r = subprocess.run([FFMPEG, "-y", "-v", "error", "-i", src, "-ac", "2", "-ar", "44100", dst],
                       capture_output=True, text=True)
    if r.returncode != 0 or not os.path.exists(dst):
        die(f"ffmpeg decode failed: {r.stderr.strip()[-400:]}")
    return dst


def run_demucs(args_list, env):
    """Run demucs.separate in this venv; return (returncode, combined output)."""
    cmd = [sys.executable, "-m", "demucs"] + args_list
    r = subprocess.run(cmd, capture_output=True, text=True, env=env)
    return r.returncode, (r.stdout + "\n" + r.stderr)


def separate(src, model, two_stems, out_dir, mp3, want_only=None):
    t0 = time.time()
    src = os.path.abspath(os.path.expanduser(src))
    if not os.path.isfile(src):
        die(f"input not found: {src}")
    if model not in MODELS:
        die(f"unknown model {model!r}; choose from {MODELS}")
    base = os.path.splitext(os.path.basename(src))[0]
    out_dir = os.path.abspath(os.path.expanduser(out_dir or f"{OUT_ROOT}/{base}"))
    os.makedirs(out_dir, exist_ok=True)
    device = pick_device()

    # demucs writes OUT/<model>/<track>/<stem>.ext ; we use a temp root then flatten.
    tmp_root = os.path.join(out_dir, ".demucs_tmp")
    shutil.rmtree(tmp_root, ignore_errors=True)
    os.makedirs(tmp_root, exist_ok=True)

    inp = src
    if not src.lower().endswith(".wav"):
        # demucs' own loader (torchaudio/ffmpeg) is flaky across versions; decode ourselves.
        inp = to_wav(src, tmp_root)

    d_args = ["-n", model, "-d", device, "-o", tmp_root, "--filename", "{stem}.{ext}"]
    if two_stems:
        d_args += ["--two-stems", two_stems]
    if mp3:
        d_args += ["--mp3", "--mp3-bitrate", "320"]
    d_args.append(inp)

    env = dict(os.environ)
    env.setdefault("PYTORCH_ENABLE_MPS_FALLBACK", "1")  # harmless on cpu; rescues unsupported MPS ops
    fallback_used = env.get("PYTORCH_ENABLE_MPS_FALLBACK") == "1"
    rc, log = run_demucs(d_args, env)
    if rc != 0 and device == "mps":
        print("warning: demucs failed on mps; retrying on cpu", file=sys.stderr)
        print(log[-1500:], file=sys.stderr)
        device = "cpu"
        d_args[d_args.index("-d") + 1] = "cpu"
        rc, log = run_demucs(d_args, env)
    if rc != 0:
        shutil.rmtree(tmp_root, ignore_errors=True)
        die(f"demucs failed (rc={rc}): {log.strip()[-800:]}")

    ext = "mp3" if mp3 else "wav"
    produced = sorted(glob.glob(os.path.join(tmp_root, model, f"*.{ext}")))
    if not produced:
        die(f"demucs reported success but wrote no files under {tmp_root}/{model}")
    files = []
    for p in produced:
        name = os.path.basename(p)
        if want_only and os.path.splitext(name)[0] not in want_only:
            continue
        dst = os.path.join(out_dir, name)
        if os.path.exists(dst):
            os.remove(dst)
        shutil.move(p, dst)
        files.append(dst)
    shutil.rmtree(tmp_root, ignore_errors=True)
    if not files:
        die("no requested stems found in demucs output")
    for f in files:
        if os.path.getsize(f) < 1000:
            die(f"output suspiciously small: {f}")
    emit({"ok": True, "files": files, "seconds": round(time.time() - t0, 1),
          "model": model, "device": device, "mps_fallback_env": fallback_used,
          "stems": [os.path.splitext(os.path.basename(f))[0] for f in files]})


def cmd_status(_):
    info = {"ok": True, "venv": VENV_PY, "venv_ok": os.path.exists(VENV_PY),
            "python": sys.version.split()[0], "ffmpeg": FFMPEG, "out_root": OUT_ROOT}
    try:
        import torch, importlib.metadata as m
        info["torch"] = torch.__version__
        info["demucs"] = m.version("demucs")
        info["mps_available"] = bool(torch.backends.mps.is_available())
    except Exception as e:
        info["ok"] = False
        info["error"] = f"import failed: {e}"
    info["device"] = "mps" if info.get("mps_available") else "cpu"
    # demucs 4.1 downloads weights from the HF hub: ~/.cache/huggingface/hub/models--adefossez--<Repo>/
    # (htdemucs -> HTDemucs, htdemucs_ft -> HTDemucs-ft, mdx_extra -> Demucs-mdx_extra).
    hub = os.environ.get("HF_HUB_CACHE") or os.path.join(os.environ.get("HF_HOME", f"{HOME}/.cache/huggingface"), "hub")
    info["model_cache"] = hub
    models_cached = {}
    for name in MODELS:
        repo = "HTDemucs" if name == "htdemucs" else ("HTDemucs-" + name[9:] if name.startswith("htdemucs_") else "Demucs-" + name)
        snaps = glob.glob(os.path.join(hub, f"models--adefossez--{repo}", "snapshots", "*", "*.safetensors"))
        models_cached[name] = bool(snaps)
    info["models_cached"] = models_cached
    info["models"] = MODELS
    print(json.dumps(info))
    sys.exit(0 if info["ok"] else 1)


def main():
    ap = argparse.ArgumentParser(prog="stems", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)

    def common(p):
        p.add_argument("audio")
        p.add_argument("--model", default="htdemucs", choices=MODELS)
        p.add_argument("--out", help=f"output dir (default {OUT_ROOT}/<basename>/)")
        p.add_argument("--mp3", action="store_true", help="write 320 kbps mp3 instead of wav")

    p = sub.add_parser("split", help="separate into drums/bass/other/vocals (6s: +guitar/piano)")
    common(p)
    p.add_argument("--two-stems", metavar="STEM", choices=STEM_NAMES, help="only STEM and no_STEM, e.g. vocals")
    p = sub.add_parser("karaoke", help="instrumental: two-stems vocals, returns no_vocals")
    common(p)
    sub.add_parser("status", help="venv, models cached, device")
    a = ap.parse_args()

    if a.cmd == "status":
        cmd_status(a)
    elif a.cmd == "split":
        separate(a.audio, a.model, a.two_stems, a.out, a.mp3)
    elif a.cmd == "karaoke":
        separate(a.audio, a.model, "vocals", a.out, a.mp3, want_only={"no_vocals"})


if __name__ == "__main__":
    main()
