#!/usr/bin/env bash
# forge-recommend — probe this machine and print the models that fit.
# Never downloads. See tools/forge/recommend.py for the rules.
#
#   bin/forge-recommend
#   bin/forge-recommend --json
#   bin/forge-recommend --ids
#   fetch-models --profile auto
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
if command -v python3 >/dev/null 2>&1; then
  exec python3 "$ROOT/tools/forge/recommend.py" "$@"
fi
exec python "$ROOT/tools/forge/recommend.py" "$@"
