# upstream clone, has its own .git; pinned commit recorded in COMFYUI_COMMIT
ComfyUI/
audio/.venv/
*.pid
logs/
run/

# model weights (tens of GB, reproducible by download)
models/*
!models/manifest.json
ComfyUI/models/

# generated output
ComfyUI/output/
scratch/*.png
scratch/*.glb
scratch/*.wav
scratch/*.json
scratch/__pycache__/
__pycache__/
*.pyc

# large binary test assets: these two are the shippable ones
vr/*.glb
!vr/pig.glb
!vr/pig_clean.glb

.DS_Store
*.log
# studio additions (2026-11-01)
output/
tools/.venv/
vr-godot/.godot/
known-good/
scratch/*/
scratch/*.stl
scratch/*.gcode
scratch/*.3mf
scratch/*.mp4
scratch/*.gif
scratch/*.jpg
scratch/*.srt

# LoRA training (tools/train/lora): venv, upstream trainer clone, datasets, runs, model shims
train/.venv/
train/ai-toolkit/
train/datasets/
train/runs/
train/models/

# local assets never go to GitHub (the installer regenerates/downloads; gold-standard stays on this Mac)
*.glb
*.gltf
gold-standard/
rig/joints_*.json
rig/attic/
rig/auto_*.log
# which GLB the room opens + the rendered views the joint auto-placer works from
vr/current.json
scratch/rig-views/
stems/.venv/

# ── never upload generated media or model assets, whatever the folder ──────────
# Belt and braces on top of the directory rules above: a stray render, stem, clip or mesh
# written somewhere new still cannot be committed.
*.glb
*.gltf
*.obj
*.fbx
*.usd
*.usdz
*.stl
*.3mf
*.blend
*.blend1
*.png
*.jpg
*.jpeg
*.webp
*.tif
*.tiff
*.exr
*.hdr
*.psd
*.kra
*.wav
*.mp3
*.flac
*.ogg
*.opus
*.aif
*.aiff
*.mp4
*.mov
*.webm
*.mkv
*.avi
*.gif
*.safetensors
*.ckpt
*.pt
*.pth
*.onnx
*.gguf
# the panel's own UI icons and the 2D game template's placeholder sprites are source, not assets
!control/brand/*.png
!game/templates/godot-2d/player/*.png
!game/templates/godot-2d/tiles/*.png

# training / stems / node packs are re-created by install.sh
ComfyUI/custom_nodes/ComfyUI-GGUF/

# Pepper's Room — build artefacts and validation frames
vr-pepper/build/
vr-pepper/scratch/
# game projects: source yes, builds/deps no (GLBs already excluded above)
game/*/node_modules/
game/*/dist/
game/*/build/
game/*/.godot/
# games built WITH the studio are not part of the studio: only templates/, tools/ and new_project.sh ship
game/*
!game/templates/
!game/tools/
!game/new_project.sh

# ── not part of this repo (2026-11-03) ────────────────────────────────────────
# This repo is the non-Mac VF Studio: code and docs only. vr-pepper/ is a
# separate local project that happens to live in this working directory, and
# ComfyUI is the build box's clone reached through an absolute-path symlink.
# Neither belongs in a commit.
vr-pepper/
/ComfyUI
